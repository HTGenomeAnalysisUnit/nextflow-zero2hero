params {
	input_file = "${projectDir}/assets/test_input.tsv" //input file table TSV: sample_id, fastq_R1, fastq_R2
	reference_genome = '/processing_data/reference_datasets/iGenomes/2025.1/Homo_sapiens/NCBI/GRCh38/Sequence/BWAIndex/genome.fa' //path to reference genome fasta file
	outdir = 'test_results' //output directory
	variant_chromosomes = 'chr21,chr22'
	variant_mode = 'gvcf'
	variant_caller = 'deepvariant'
	variant_caller_use_gpu = false
}