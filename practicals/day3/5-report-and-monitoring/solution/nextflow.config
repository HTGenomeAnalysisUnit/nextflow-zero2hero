params {
	// Input/output params
	input_file = '' //input file table TSV: sample_id, fastq_R1, fastq_R2
	reference_genome = '' //path to reference genome fasta file
	outdir = 'results' //output directory

	// Advanced params
	publish_mode = 'copy'
    
	// nf-core profiles config options
    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    hostnames                  = [:]
    config_profile_description = null
    config_profile_contact     = null
    config_profile_url         = null
    config_profile_name        = null
}

// Computational environments

conda.enabled           = false
conda.channels          = ['conda-forge', 'bioconda']
docker.enabled          = false
singularity.enabled     = true

process.executor = "slurm"
process.queue = "cpuq"


process {

  withName: 'PREPARE_GENOME:SAMTOOLS_FAIDX' {
	cpus = 1
	memory = 500.MB
  }

  withName: 'FASTP' {
	cpus = 4
	memory = 2.GB
  }

  withName: 'PREPARE_GENOME:GATK4_CREATESEQUENCEDICTIONARY' {

    cpus = 1
    memory = 2.GB
  }

  withName: 'ALIGNMENT:BWA_MEM' {

	cpus = 4
	memory = 8.GB
  }

  withName: 'ALIGNMENT:SAMTOOLS_MERGE' {
	cpus = 4
	memory = 500.MB
  }
}


// Set filename and location for timeline, report, trace and dag
def trace_timestamp = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}


